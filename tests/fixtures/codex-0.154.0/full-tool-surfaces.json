                "project_id",
                "campaign_id",
                "operation_id"
              ],
              "additionalProperties": false
            }
          },
          {
            "type": "function",
            "name": "galatea_plan_run",
            "description": "Persist a governed run plan bound to approved campaign revision, immutable inputs and budget; this is a mutation.",
            "strict": false,
            "parameters": {
              "type": "object",
              "properties": {
                "attempt": {
                  "type": "integer"
                },
                "campaign_id": {
                  "type": "string"
                },
                "config_id": {
                  "type": "string"
                },
                "project_id": {
                  "type": "string"
                },
                "release_id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "trial",
                    "champion",
                    "evaluate"
                  ]
                },
                "step_id": {
                  "type": "string"
                }
              },
              "required": [
                "project_id",
                "campaign_id",
                "step_id",
                "attempt",
                "release_id",
                "config_id",
                "role"
              ],
              "additionalProperties": false
            }
          },
          {
            "type": "function",
            "name": "galatea_query_runs",
            "description": "Query scoped MLflow training and validation evidence through the Tracking API with bounded results.",
            "strict": false,
            "parameters": {
              "type": "object",
              "properties": {
                "campaign_id": {
                  "type": "string"
                },
                "cursor": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "limit": {
                  "type": "integer"
                },
                "project_id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "trial",
                    "champion",
                    "evaluate"
                  ]
                }
              },
              "required": [
                "project_id",
                "campaign_id"
              ],
              "additionalProperties": false
            }
          },
          {
            "type": "function",
            "name": "galatea_stop_job",
            "description": "Request stop of a scoped governed operation and preserve its receipt until backend termination is confirmed.",
            "strict": false,
            "parameters": {
              "type": "object",
              "properties": {
                "campaign_id": {
                  "type": "string"
                },
                "operation_id": {
                  "type": "string"
                },
                "project_id": {
                  "type": "string"
                },
