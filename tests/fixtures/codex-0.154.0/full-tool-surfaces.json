              "type": "object",
              "properties": {
                "campaign_id": {
                  "type": "string"
                },
                "idempotency_key": {
                  "type": "string"
                },
                "plan_id": {
                  "type": "string"
                },
                "project_id": {
                  "type": "string"
                }
              },
              "required": [
                "project_id",
                "campaign_id",
                "plan_id",
                "idempotency_key"
              ],
              "additionalProperties": false
            }
          },
          {
            "type": "function",
            "name": "galatea_verify_candidate",
