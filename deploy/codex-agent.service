[Unit]
Description=Native Codex Agent Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex-agent
Group=codex-agent
WorkingDirectory=/var/lib/codex-agent
EnvironmentFile=/etc/codex-agent/host.env
Environment=PYTHONNOUSERSITE=1
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE PYTHONINSPECT
ExecStart=/opt/codex-agent/bin/codex-agent --config /var/lib/codex-agent/agent.json serve --host 0.0.0.0 --port 18880
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/codex-agent/codex-home
ReadWritePaths=/var/lib/codex-agent/codex-process-home
ReadWritePaths=/var/lib/codex-agent/state
ReadWritePaths=/var/lib/codex-agent/workspaces
ReadOnlyPaths=/var/lib/codex-agent/codex-home/config.toml
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
